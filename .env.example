# Copiar a .env.local y rellenar. Este archivo SÍ va al repo: solo nombres, sin valores.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# Correo del formulario (partida 06). Sin estos datos la consulta se guarda igual, pero no se envían correos.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Destinatarios del aviso (varios separados por comas)
CONTACT_TO=
# Opcional: remitente visible, p. ej. Serveco Asesores <web@serveco.es>
SMTP_FROM=

NEXT_PUBLIC_GA_ID=
